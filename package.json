{
  "name": "daoyan-cli",
  "version": "0.0.4",
  "description": "Agent 驱动的 ComfyUI 节点编辑器 + 执行运行时：节点编辑、异步 task、local/remote 引擎生命周期与产物版本留痕。An agent-native ComfyUI node editor and execution runtime.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/yuanbaobaoo/daoyan-cli.git"
  },
  "homepage": "https://github.com/yuanbaobaoo/daoyan-cli#readme",
  "bugs": "https://github.com/yuanbaobaoo/daoyan-cli/issues",
  "bin": {
    "daoyan": "./dist/cli.mjs",
    "dycli": "./dist/cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "test -f dist/cli.mjs || npm run build",
    "prepublishOnly": "npm run typecheck && npm run build",
    "test": "node --experimental-strip-types --test test/*.test.mts"
  },
  "keywords": [
    "comfyui",
    "ai-agent",
    "agent-tools",
    "cli",
    "headless",
    "pipeline",
    "video-generation",
    "storyboard",
    "typescript",
    "aigc",
    "node-editor",
    "agent-skill",
    "workflow-automation",
    "local-first"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
